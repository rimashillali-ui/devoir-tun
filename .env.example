# Variables d'environnement Devoiratouna
# Copier ce fichier en .env (local) et saisir les mêmes valeurs dans Vercel
# (Project Settings -> Environment Variables, pour Production ET Preview).
#
# Ces clés sont publiques (publishable / anon) : elles peuvent apparaître dans
# le navigateur. La sécurité repose sur les policies RLS de la base.

# --- Côté navigateur (obligatoire, préfixe VITE_) ---
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=votre_cle_publishable
VITE_SUPABASE_PROJECT_ID=votre_project_id

# --- Côté serveur (SSR + server functions) : mêmes valeurs ---
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_PUBLISHABLE_KEY=votre_cle_publishable
SUPABASE_PROJECT_ID=votre_project_id
